{
  "name": "@iz/design-system",
  "version": "0.0.1",
  "description": "IZ Design System — accessible, token-first React components with DTCG tokens and an MCP spec server.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "agent",
    "docs/specs",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/design-tokens.css",
    "./tokens.json": "./docs/specs/tokens.dtcg.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build": "vite build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tokens:build": "node scripts/tokens-build.mjs",
    "tokens:validate": "node scripts/tokens-validate.mjs",
    "build:tokens": "node scripts/tokens-validate.mjs && node scripts/tokens-build.mjs",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:specs": "node scripts/check-specs.mjs",
    "check": "npm run lint && npm run lint:css && npm run type-check && npm run tokens:validate && npm run tokens:build && npm run check:contrast && npm run check:specs && npm run test",
    "changeset": "changeset",
    "tokens:sync": "echo '[tokens-sync] Phase 2: diff tokens/figma-export/*.json against tokens/' && exit 0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-aria-components": "1.22.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "style-dictionary": "5.6.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.4",
    "vitest-axe": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
