{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["src/styles/design-tokens.css", "dist/**", "storybook-static/**"],
  "rules": {
    "selector-class-pattern": "^[a-z][a-zA-Z0-9]+$",
    "custom-property-pattern": "^iz-[a-z0-9-]+$",
    "declaration-no-important": true,
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla", "oklch", "color-mix"],
    "unit-disallowed-list": [
      ["px", "rem", "em", "ms", "s"],
      {
        "ignoreProperties": { "px": ["/^outline/", "/^border/", "/^scroll-/"], "rem": [], "em": [], "ms": [], "s": [] },
        "message": "Use var(--iz-*) tokens instead of raw units (docs/TOKENS.md). Allowed: 0, %, auto, calc() on tokens."
      }
    ],
    "declaration-property-value-disallowed-list": { "outline": ["none", "0"] },
    "property-no-vendor-prefix": true,
    "media-feature-range-notation": "context"
  }
}
