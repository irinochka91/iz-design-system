{
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "{duration.100}"
    },
    "normal": {
      "$type": "duration",
      "$value": "{duration.200}"
    },
    "slow": {
      "$type": "duration",
      "$value": "{duration.300}"
    },
    "moment": {
      "$type": "duration",
      "$value": "{duration.700}",
      "$description": "A signature moment (HANDOFF § Motion spec): goal met, stage up. Five events earn it; everything else uses fast/normal/slow."
    }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": "{curve.standard}"
    },
    "emphasized": {
      "$type": "cubicBezier",
      "$value": "{curve.emphasized}"
    }
  }
}
